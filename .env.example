# Copie para .env (copy .env.example .env) e troque o segredo. O .env NUNCA vai para o GitHub.
# Segredo usado para assinar os tokens JWT. Precisa ter 32 caracteres ou mais e é o MESMO em todos os serviços.
JWT_SEGREDO=troque-por-um-segredo-longo-com-32-ou-mais-caracteres
TOKEN_MINUTOS=60
LOGIN_MAX_FALHAS=5
LOGIN_JANELA_SEGUNDOS=300
DADOS_EXEMPLO=1
DOCS=0
